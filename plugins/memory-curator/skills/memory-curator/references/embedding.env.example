# Copy these entries into the project .env; do not overwrite an existing file.
# Existing process environment variables take precedence, including empty values.
# Native BGE-M3: use the full /embed URL; the adapter also checks /health.
EMBEDDING_BASE_URL=http://127.0.0.1:8000/embed
EMBEDDING_MODEL=BGE-M3

# Optional. Leave empty or omit for a self-hosted service without authentication.
EMBEDDING_API_KEY=

# For OpenAI-compatible services, replace BASE_URL and MODEL above:
# EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# EMBEDDING_MODEL=your-served-model-name
# The adapter appends /embeddings unless already present; it never guesses /v1.
# Spaces around = and an optional export prefix are accepted.
# Quote values containing spaces or #. No shell or variable expansion is performed.
